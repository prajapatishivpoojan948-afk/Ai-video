<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Video Generator</title>
    <style>
        :root {
            --bg-color: #121212;
            --surface-color: #1e1e1e;
            --primary-color: #bb86fc;
            --secondary-color: #03dac6;
            --text-color: #e0e0e0;
            --text-secondary: #aaaaaa;
            --error-color: #cf6679;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            display: flex;
            height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 350px;
            background-color: var(--surface-color);
            border-right: 1px solid #333;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .sidebar-header {
            padding: 20px;
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--primary-color);
            border-bottom: 1px solid #333;
        }

        .script-input-container {
            padding: 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        textarea {
            width: 100%;
            height: 80%;
            background-color: #2c2c2c;
            color: var(--text-color);
            border: 1px solid #444;
            border-radius: 8px;
            padding: 12px;
            resize: none;
            font-size: 1rem;
            box-sizing: border-box;
        }

        textarea:focus {
            outline: none;
            border-color: var(--primary-color);
        }

        .generate-btn {
            background-color: var(--primary-color);
            color: #000;
            border: none;
            padding: 15px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 15px;
            transition: background-color 0.2s;
        }

        .generate-btn:hover {
            background-color: #9965f4;
        }

        /* Main Content */
        .main-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            padding: 20px;
            overflow-y: auto;
        }

        .settings-bar {
            display: flex;
            gap: 20px;
            background-color: var(--surface-color);
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .setting-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .setting-group label {
            font-size: 0.8rem;
            color: var(--text-secondary);
        }

        select, input[type="number"] {
            background-color: #2c2c2c;
            color: var(--text-color);
            border: 1px solid #444;
            border-radius: 4px;
            padding: 6px;
        }

        .preview-area {
            flex-grow: 1;
            background-color: #000;
            border-radius: 8px;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            min-height: 400px;
        }

        /* Aspect Ratio Containers */
        .canvas-16-9 {
            width: 90%;
            padding-top: 50.625%;
        }

        .canvas-9-16 {
            height: 90%;
            aspect-ratio: 9 / 16;
        }

        .canvas-1-1 {
            width: 70%;
            aspect-ratio: 1 / 1;
        }

        .canvas {
            background-color: #333;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: 8px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.5rem;
            color: var(--text-secondary);
            text-align: center;
            padding: 20px;
            box-sizing: border-box;
        }

        .caption-overlay {
            position: absolute;
            bottom: 20px;
            left: 20px;
            right: 20px;
            background: rgba(0, 0, 0, 0.7);
            padding: 15px;
            text-align: center;
            font-size: 1.2rem;
            border-radius: 4px;
        }

        /* Scenes List */
        .scenes-container {
            margin-top: 20px;
            display: flex;
            gap: 15px;
            overflow-x: auto;
            padding-bottom: 10px;
        }

        .scene-card {
            background-color: var(--surface-color);
            border: 1px solid #333;
            border-radius: 8px;
            min-width: 200px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .scene-card.active {
            border-color: var(--primary-color);
        }

        .scene-title {
            font-weight: bold;
            color: var(--primary-color);
        }

        .scene-text {
            font-size: 0.9rem;
            color: var(--text-secondary);
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-header">AI Video Generator</div>
        <div class="script-input-container">
            <label for="script">Script</label>
            <textarea id="script" placeholder="Enter your script here. Separate scenes with a new line..."></textarea>
            <button class="generate-btn" onclick="generateScenes()">Breakdown Script</button>
        </div>
    </div>

    <div class="main-content">
        <div class="settings-bar">
            <div class="setting-group">
                <label for="aspect-ratio">Aspect Ratio</label>
                <select id="aspect-ratio" onchange="updateAspectRatio()">
                    <option value="16-9">16:9 (Landscape)</option>
                    <option value="9-16">9:16 (Portrait)</option>
                    <option value="1-1">1:1 (Square)</option>
                </select>
            </div>
            <div class="setting-group">
                <label for="style-select">Visual Style</label>
                <select id="style-select">
                    <option value="photorealistic">Photorealistic</option>
                    <option value="anime">Anime</option>
                    <option value="3d-render">3D Render</option>
                    <option value="minimalist">Minimalist</option>
                </select>
            </div>
            <div class="setting-group">
                <label for="voice-select">Voice Narration</label>
                <select id="voice-select"></select>
            </div>
            <div class="setting-group">
                <label for="slide-duration">Scene Duration (sec)</label>
                <input type="number" id="slide-duration" value="5" min="2" max="10">
            </div>
        </div>

        <div class="preview-area">
            <div id="canvas-wrapper" class="canvas-16-9">
                <div id="video-canvas" class="canvas">
                    AI Video Preview will appear here
                </div>
                <div id="caption-box" class="caption-overlay" style="display: none;"></div>
            </div>
        </div>

        <div class="scenes-container" id="scenes-container">
            <!-- Scene cards will appear here -->
        </div>
        
        <div style="margin-top: 20px; display: flex; gap: 10px;">
             <button class="generate-btn" onclick="playPreview()">Preview Video</button>
        </div>
    </div>

    <script>
        let scenes = [];
        let currentSceneIndex = 0;
        let synthesis = window.speechSynthesis;
        let voices = [];

        // Load voices
        function loadVoices() {
            voices = synthesis.getVoices();
            const voiceSelect = document.getElementById('voice-select');
            voiceSelect.innerHTML = '';
            voices.forEach((voice, index) => {
                const option = document.createElement('option');
                option.textContent = voice.name + ' (' + voice.lang + ')';
                option.value = index;
                voiceSelect.appendChild(option);
            });
        }

        if (synthesis.onvoiceschanged !== undefined) {
            synthesis.onvoiceschanged = loadVoices;
        }
        loadVoices();

        function generateScenes() {
            const script = document.getElementById('script').value;
            const lines = script.split('\n').filter(line => line.trim() !== '');
            
            scenes = lines.map((line, index) => ({
                id: index + 1,
                text: line.trim()
            }));

            renderSceneCards();
        }

        function renderSceneCards() {
            const container = document.getElementById('scenes-container');
            container.innerHTML = '';

            scenes.forEach((scene, index) => {
                const card = document.createElement('div');
                card.className = `scene-card ${index === currentSceneIndex ? 'active' : ''}`;
                card.innerHTML = `
                    <div class="scene-title">Scene ${scene.id}</div>
                    <div class="scene-text">${scene.text}</div>
                `;
                container.appendChild(card);
            });
        }

        function updateAspectRatio() {
            const ratio = document.getElementById('aspect-ratio').value;
            const wrapper = document.getElementById('canvas-wrapper');
            wrapper.className = `canvas-${ratio}`;
        }

        function playPreview() {
            if (scenes.length === 0) return;
            currentSceneIndex = 0;
            playNextScene();
        }

        function playNextScene() {
            if (currentSceneIndex >= scenes.length) {
                document.getElementById('caption-box').style.display = 'none';
                return;
            }

            const scene = scenes[currentSceneIndex];
            const canvas = document.getElementById('video-canvas');
            const captionBox = document.getElementById('caption-box');
            const duration = document.getElementById('slide-duration').value;
            const voiceSelect = document.getElementById('voice-select');

            // Update active card
            const cards = document.querySelectorAll('.scene-card');
            cards.forEach(card => card.classList.remove('active'));
            if (cards[currentSceneIndex]) cards[currentSceneIndex].classList.add('active');

            // Simulate AI video generation visualization
            const style = document.getElementById('style-select').value;
            canvas.innerHTML = `Generating ${style} visual for Scene ${scene.id}...`;
            
            // Speak caption
            captionBox.textContent = scene.text;
            captionBox.style.display = 'block';
            
            const utterance = new SpeechSynthesisUtterance(scene.text);
            if (voices[voiceSelect.value]) {
                utterance.voice = voices[voiceSelect.value];
            }
            synthesis.speak(utterance);

            // Move to next scene after duration
            setTimeout(() => {
                currentSceneIndex++;
                playNextScene();
            }, duration * 1000);
        }

    </script>
</body>
</html>
